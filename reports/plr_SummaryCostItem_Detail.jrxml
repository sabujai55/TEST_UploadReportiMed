<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="plr_SummaryCostItem_Detail" language="groovy" pageWidth="555" pageHeight="802" columnWidth="555" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0">
	<property name="ireport.zoom" value="2.5937424601000028"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="VisitId" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["1"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select	a.*
, bh.base_billing_group_id as billhead_id
, bh.description_th as billhead_name_th
, bh.description_en as billhead_name_en
from
(
	select 	v.visit_id
			, oi.verify_date
			, oi.verify_time
			, bbg.base_billing_group_id
			, bbg.description_th as billinggroup_name_th
			, bbg.description_en as billinggroup_name_en
			, i.item_code
			, i.common_name as item_name
			, oi.quantity
			, oi.unit_price_sale
			, oi.unit_price_sale::decimal * oi.quantity::decimal as charge_amt
			, oi.verify_spid
			, bsp.base_department_id
			, case when bsp.base_department_id = '2603' then 1 else 2 end as flag_or
			, case when bsp.base_department_id = '2603' then 'อุปกรณ์ของใช้และเครื่องมือที่ใช้ในห้องผ่าตัด' else 'อุปกรณ์ของใช้และเครื่องมือที่ใช้นอกห้องผ่าตัด' end as flag_name
			, case when bsp.base_department_id = '2603' then 'Equipment inside operationg room' else 'Equipment outside operationg room' end as flag_name_en
			, substring(bbg.law_code,1,position('.' in bbg.law_code)-1) || '.' ||
			  case when position('.' in substring(bbg.law_code,position('.' in bbg.law_code)+1,length(bbg.law_code))) > 0
			  then substring(substring(bbg.law_code,position('.' in bbg.law_code)+1,length(bbg.law_code)),1, position('.' in substring(bbg.law_code,position('.' in bbg.law_code)+1,length(bbg.law_code)))-1)
			  else substring(bbg.law_code,position('.' in bbg.law_code)+1,length(bbg.law_code)) end as billing_head
			, substring(bbg.base_billing_group_id,1,8) as billing_head_id
			, substring(bbg.base_billing_group_id,9,length(bbg.base_billing_group_id)) as xxx
	from 	visit v left join admit a on v.visit_id = a.visit_id
			inner join order_item oi on v.visit_id = oi.visit_id
			inner join item i on oi.item_id = i.item_id
			inner join base_service_point bsp on oi.verify_spid = bsp.base_service_point_id
			inner join base_billing_group bbg on oi.base_billing_group_id = bbg.base_billing_group_id
	where 	v.visit_id = '$P!{VisitId}'
)a
left join
		(
			select 	bbg.base_billing_group_id
					, bbg.law_code
					, bbg.description_th
					, bbg.description_en
					, substring(bbg.law_code,1,position('.' in bbg.law_code)-1) || '.' ||
					  case when position('.' in substring(bbg.law_code,position('.' in bbg.law_code)+1,length(bbg.law_code))) > 0
					  then substring(substring(bbg.law_code,position('.' in bbg.law_code)+1,length(bbg.law_code)),1, position('.' in substring(bbg.law_code,position('.' in bbg.law_code)+1,length(bbg.law_code)))-1)
					  else substring(bbg.law_code,position('.' in bbg.law_code)+1,length(bbg.law_code)) end as billing_head
					, substring(bbg.base_billing_group_id,1,8) as billing_head_id
			from 	base_billing_group bbg
			where 	bbg.base_billing_group_id like '07.%'
					--and position('.' in substring(bbg.law_code,position('.' in bbg.law_code)+1,length(bbg.law_code))) = 0
					and substring(bbg.base_billing_group_id,10,2) = '00'
		)bh on a.billing_head = bh.billing_head and a.billing_head_id = bh.billing_head_id
order by a.flag_or, bh.billing_head_id, a.base_billing_group_id]]>
	</queryString>
